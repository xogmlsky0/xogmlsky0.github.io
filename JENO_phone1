<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>가상 핸드폰</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&display=swap">
<style>
:root{--bg:#e6e4df;--ink:#1c1c1e;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#131315;--ink:#f2f2f2}}
:root[data-theme="dark"]{--bg:#131315;--ink:#f2f2f2}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{background:var(--bg);color:var(--ink);font-family:"Pretendard","Noto Sans KR","Apple SD Gothic Neo",system-ui,sans-serif;display:flex;align-items:center;justify-content:center}
.phone{--wp:linear-gradient(160deg,#2b5876,#4e4376 60%,#c06c84);height:min(780px,100%);aspect-ratio:9/16;border-radius:52px;border:9px solid #0c0c0e;background:#000;overflow:hidden;position:relative;box-shadow:0 30px 60px rgba(0,0,0,.35)}
.screen{position:absolute;inset:0;background:var(--wp) center/cover no-repeat;color:#fff;overflow:hidden}
.notch{position:absolute;top:9px;left:50%;transform:translateX(-50%);width:92px;height:26px;background:#000;border-radius:14px;z-index:20}
.status{position:absolute;top:0;left:0;right:0;height:46px;padding:14px 28px 0;display:flex;justify-content:space-between;font-size:14px;font-weight:600;z-index:15;pointer-events:none}
.layer{position:absolute;inset:0;padding-top:56px;transition:opacity .25s,transform .25s}
.layer.off{opacity:0;pointer-events:none;transform:scale(.96)}
#lock{background:#000;display:flex;flex-direction:column;align-items:center;padding-top:110px;cursor:pointer;z-index:10;transition:opacity .3s,transform .35s}
#lock.off{transform:translateY(-60px)}
#lock .d{font-size:17px;opacity:.9}
#lock .t{font-size:92px;font-weight:300;line-height:1.05;letter-spacing:-2px}
#lock .hint{margin-top:auto;margin-bottom:46px;font-size:14px;opacity:.8}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px 8px;padding:8px 18px}
.grid .wg{grid-row:1}
.grid .ic:nth-of-type(1){grid-column:1;grid-row:2}
.grid .ic:nth-of-type(2){grid-column:2;grid-row:2}
.grid .ic:nth-of-type(3){grid-column:1;grid-row:3}
.grid .ic:nth-of-type(4){grid-column:2;grid-row:3}
.grid .ic:nth-of-type(5){grid-column:3;grid-row:2}
.grid .ic:nth-of-type(6){grid-column:4;grid-row:2}
.grid .ic:nth-of-type(7){grid-column:3;grid-row:3}
.ic{text-shadow:0 1px 3px rgba(0,0,0,.45);display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;background:none;border:0;color:#fff;cursor:pointer;font-family:inherit}
.ic i{width:46px;height:46px;border-radius:11px;overflow:hidden;display:grid;place-items:center;font-style:normal;box-shadow:0 2px 8px rgba(0,0,0,.25);transition:transform .12s}
.ic:active i{transform:scale(.92)}
.wg{grid-column:1/-1;width:calc(50% - 4px);display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;margin-bottom:4px;text-shadow:0 1px 3px rgba(0,0,0,.45)}
.w{width:100%;height:136px;border-radius:24px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.25);overflow:hidden;text-shadow:none}
.wx{background:rgba(140,140,145,.2);text-shadow:0 1px 3px rgba(0,0,0,.45);display:flex;flex-direction:column}
.wx b{font-size:15px;font-weight:600}.wx em{font-style:normal;font-size:44px;font-weight:300;line-height:1.05}.wx u{text-decoration:none;font-size:14px;margin-top:auto}.wx small{font-size:12px;line-height:1.35}
.qt{background:#000;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
.qt p{font-size:15px;font-weight:700;line-height:1.35}.qt small{font-size:9px;margin-top:6px}
.srch{position:absolute;left:50%;bottom:134px;transform:translateX(-50%);display:flex;align-items:center;gap:5px;font-size:12px;background:rgba(255,255,255,.22);backdrop-filter:blur(10px);padding:6px 14px;border-radius:16px}
.dock{position:absolute;left:14px;right:14px;bottom:34px;height:84px;border-radius:30px;background:rgba(255,255,255,.22);backdrop-filter:blur(14px);display:flex;justify-content:space-around;align-items:center}
.dock .ic span{display:none}
.bar{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);width:120px;height:5px;border-radius:3px;background:#fff;opacity:.85;z-index:30;cursor:pointer;border:0;padding:0}
.bar::after{content:"";position:absolute;inset:-14px -10px}
#app{background:#f4f4f6;color:#1c1c1e;z-index:12}
#app header{height:44px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:17px}
#app .body{height:calc(100% - 56px - 44px - 24px);overflow:auto;padding:8px 16px}
.disp{font-size:64px;font-weight:300;text-align:right;padding:30px 8px 12px;min-height:130px;overflow:hidden;white-space:nowrap}
.keys{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.keys button{height:64px;border-radius:32px;border:0;font-size:24px;background:#e1e1e6;color:#1c1c1e;font-family:inherit;cursor:pointer}
.keys button:active{filter:brightness(.88)}
.keys .o{background:#ff9f0a;color:#fff}.keys .f{background:#c7c7cc}.keys .z{grid-column:span 2;text-align:left;padding-left:26px}
textarea{width:100%;height:100%;border:0;background:#fff;border-radius:16px;padding:16px;font:16px/1.6 inherit;font-family:inherit;resize:none;outline:0;color:#1c1c1e}
.sw{font-size:60px;font-weight:300;text-align:center;padding:60px 0 40px;font-variant-numeric:tabular-nums}
.row{display:flex;gap:12px;justify-content:center}
.btn{border:0;border-radius:28px;padding:16px 28px;font-size:16px;font-weight:600;font-family:inherit;cursor:pointer;background:#e1e1e6;color:#1c1c1e}
.btn.go{background:#30b455;color:#fff}.btn.stop{background:#ff453a;color:#fff}
.sec{font-size:13px;color:#6e6e73;margin:14px 4px 8px}
.wps{display:flex;gap:10px}
.wps button{width:64px;height:100px;border-radius:14px;border:3px solid transparent;cursor:pointer}
.wps button.sel{border-color:#0a84ff}
#pin{z-index:14;background:rgba(0,0,0,.45);backdrop-filter:blur(22px);display:flex;flex-direction:column;align-items:center;padding-top:110px}
.pt{font-size:17px;margin-bottom:22px;text-align:center;min-height:24px}
.dots{display:flex;gap:16px;margin-bottom:44px}
.dots span{width:14px;height:14px;border-radius:50%;border:2px solid #fff}
.dots span.on{background:#fff}
.dots.shake{animation:sh .35s}
@keyframes sh{20%,60%{transform:translateX(-10px)}40%,80%{transform:translateX(10px)}}
.pk{display:grid;grid-template-columns:repeat(3,60px);gap:12px}
.pk button{height:60px;border-radius:50%;border:0;background:rgba(255,255,255,.2);color:#fff;font-size:24px;font-family:inherit;cursor:pointer}
.pk button.t{background:none;font-size:16px}
.pk button:active{background:rgba(255,255,255,.45)}
.pin-in{width:100%;border:0;border-radius:14px;padding:14px;font-size:16px;font-family:inherit;margin-bottom:10px;background:#fff;color:#1c1c1e}
#app.ig{background:#0c1014;color:#fff}
#app.ig header{display:none}
#app.ig .body{position:relative;height:100%;padding:0;overflow:hidden;display:flex;flex-direction:column}
.ig-top{display:flex;align-items:center;justify-content:space-between;padding:6px 16px;flex:none}
.ig-top h2{font:italic 600 26px/1 "Playfair Display",Georgia,"Times New Roman",serif;letter-spacing:.3px;background:linear-gradient(90deg,#fff,#c9d1d9);-webkit-background-clip:text;background-clip:text;color:transparent}
.ig-top .tb{background:none;border:0;color:#fff;padding:0;position:relative;cursor:pointer;display:block}
.ig-top .dot::after{content:"";position:absolute;top:-1px;right:-1px;width:8px;height:8px;border-radius:50%;background:#ff3040}
.ig-feed{flex:1;min-height:0;overflow:auto}
.ig-logo{height:24px;width:auto;display:block}
.ig-prof{display:none;flex:1;min-height:0;overflow:auto}
.prof .ig-top,.prof .ig-feed{display:none}
.prof .ig-prof{display:block}
.pf-bar{display:flex;align-items:center;gap:10px;padding:4px 14px;font-size:15px;font-weight:700}
.pf-bar span{display:flex;align-items:center;gap:5px;flex:1}
.pf-bar div{display:flex;gap:16px;align-items:center}
.pf-bar button{background:none;border:0;color:#fff;padding:0;cursor:pointer;display:block}
.pf-head{display:flex;align-items:center;gap:16px;padding:8px 16px 2px}
.pf-av{width:72px;height:72px;border-radius:50%;overflow:hidden;flex:none}
.pf-av img{width:100%;height:100%;object-fit:cover;display:block}
.pf-info{flex:1;min-width:0}
.pf-nm{font-size:12px;margin-bottom:6px}
.pf-st{display:flex;justify-content:space-between;font-size:10px;line-height:1.35;gap:6px}
.pf-st b{display:block;font-size:13px;font-weight:600}
.pf-bio{padding:4px 16px 10px;font-size:12px}
.pf-btns{display:flex;gap:6px;padding:0 16px 8px}
.pf-btns button{height:30px;border:0;border-radius:9px;font-weight:600;font-size:12px;font-family:inherit;color:#fff;background:#262b33;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px}
.pf-btns .ed,.pf-btns .sh{flex:1}
.pf-btns .ad{width:38px}
.pf-tabs{display:flex}
.pf-tabs button{flex:1;background:none;border:0;border-bottom:2px solid transparent;color:#a8b0b8;padding:7px 0;display:grid;place-items:center;cursor:pointer}
.pf-tabs button.on{color:#fff;border-bottom-color:#fff}
.pf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.pf-grid div{aspect-ratio:3/4;overflow:hidden}
.pf-grid img{width:100%;height:100%;object-fit:cover;display:block}
.pf-empty{display:none;padding:40px 0;text-align:center;color:#a8b0b8;font-size:13px}
.ig-st{display:flex;gap:14px;padding:8px 14px 12px;overflow-x:auto}
.ig-st div{display:flex;flex-direction:column;align-items:center;gap:5px;font-size:11px;flex:none;width:64px}
.ig-st b{width:60px;height:60px;border-radius:50%;padding:2.5px;position:relative;display:block}
.ig-st b i{width:100%;height:100%;border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:26px;border:2px solid #0c1014;overflow:hidden}
.ig-st u{position:absolute;right:-2px;bottom:-2px;width:20px;height:20px;border-radius:50%;background:#fff;color:#000;font-size:16px;line-height:18px;text-align:center;text-decoration:none;font-weight:700;border:2px solid #0c1014}
.ig-p{margin-bottom:14px}
.ig-ph{display:flex;align-items:center;gap:10px;padding:6px 14px}
.ig-ph .av{width:32px;height:32px;border-radius:50%;overflow:hidden;flex:none}
.ig-ph .nm{flex:1;line-height:1.25;font-size:13px;font-weight:600}
.ig-ph .nm span{display:block;color:#a8b0b8;font-size:11px;font-weight:400}
.ig-ph .fl{background:#262b33;color:#fff;border:0;border-radius:8px;padding:6px 12px;font-size:12px;font-family:inherit;cursor:pointer}
.ig-img{height:240px;position:relative}
.ig-img em{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.55);font-style:normal;font-size:11px;padding:3px 8px;border-radius:12px}
.ig-act{display:flex;align-items:center;gap:14px;padding:10px 14px 4px}
.ig-act button{display:flex;align-items:center;gap:5px;background:none;border:0;color:#fff;font-family:inherit;font-size:13px;cursor:pointer;padding:0}
.ig-act .sv{margin-left:auto}
.ig-cap{padding:2px 14px;font-size:13px;line-height:1.4}
.ig-cap span,.ig-tm{color:#a8b0b8}
.ig-tm{padding:2px 14px;font-size:11px}
.ig-nav{flex:none;display:flex;justify-content:space-around;align-items:center;height:48px;padding:0 18px;border-top:1px solid #1c222a;background:#0c1014}
.ig-nav button{background:none;border:0;color:#a8b0b8;padding:8px 16px;border-radius:26px;cursor:pointer;display:grid;place-items:center}
.ig-nav button.on{color:#fff;background:#232932}
.ig-nav .me{width:24px;height:24px;border-radius:50%;overflow:hidden;background:#232932;display:block}
.ig-ph .av img,.ig-img img,.ig-st b i img,.ig-nav .me img{width:100%;height:100%;object-fit:cover;display:block}
.ig-cap .mt{color:#8ea3ff}
.ig-ph .nm svg{vertical-align:-3px;margin-left:4px}
.ig-dm{display:none;flex:1;min-height:0;overflow:auto}
.dm .ig-top,.dm .ig-feed{display:none}
.dm .ig-dm{display:block}
.dm-top{display:flex;align-items:center;justify-content:space-between;padding:8px 16px}
.dm-top span{display:flex;align-items:center;gap:6px;font-size:18px;font-weight:700}
.dm-top .rd{width:8px;height:8px;border-radius:50%;background:#ff3040;display:block}
.dm-top svg{display:block}
.dm-top button{background:none;border:0;color:#fff;padding:0;cursor:pointer;display:block}
.dm-search{display:flex;align-items:center;gap:12px;margin:10px 16px 6px;height:40px;padding:0 14px;border-radius:14px;background:#232932;color:#a8b0b8;font-size:14px}
.dm-note{display:flex;flex-direction:column;align-items:center;width:104px;margin:14px 16px 0;cursor:pointer}
.dm-note .bub{background:#232932;color:#c3cad2;border-radius:18px;padding:8px 10px;text-align:center;font-size:11px;line-height:1.35;margin-bottom:-12px;position:relative;z-index:1}
.dm-note .av{width:76px;height:76px;border-radius:50%;overflow:hidden}
.dm-note img,.dm-row img{width:100%;height:100%;object-fit:cover;display:block}
.dm-note b{margin-top:6px;font-weight:400;color:#a8b0b8;font-size:12px}
.dm-note small{display:flex;align-items:center;gap:3px;font-size:10px;font-weight:600}
.dm-hd{display:flex;justify-content:space-between;padding:16px 16px 6px;font-size:15px}
.dm-hd u{color:#7c8cff;text-decoration:none;cursor:pointer}
.dm-row{display:flex;align-items:center;gap:14px;padding:12px 16px;cursor:pointer}
.dm-row .av{width:56px;height:56px;border-radius:50%;overflow:hidden;flex:none}
.dm-row .tx{min-width:0;flex:1;display:flex;flex-direction:column;gap:2px;font-size:14px}
.dm-row .tx b{font-weight:700}
.dm-row .tx svg{vertical-align:-2px;margin-left:4px}
.dm-row .ub{width:10px;height:10px;border-radius:50%;background:#5b6cf0;flex:none}
.dm-row .tx span{color:#a8b0b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ig-chat{position:absolute;inset:0;background:#000;display:none;flex-direction:column;z-index:5}
.ig-chat.on{display:flex}
.ch{display:flex;align-items:center;gap:10px;padding:8px 14px;flex:none}
.ch button{background:none;border:0;color:#fff;padding:0;cursor:pointer;display:block}
.ch .hav{width:34px;height:34px;border-radius:50%;object-fit:cover}
.ch .hn{flex:1;min-width:0;line-height:1.25;font-size:14px}
.ch .hn b{display:block;font-weight:700}
.ch .hn svg{vertical-align:-2px;margin-left:4px}
.ch .hn small{color:#8a919a;font-size:11px}
.cm{flex:1;min-height:0;overflow:auto;padding:8px 12px 10px;display:flex;flex-direction:column}
.cd{text-align:center;color:#8a919a;font-size:11px;margin:12px 0 8px}
.cr{display:flex;align-items:flex-end;gap:8px;margin-top:3px}
.cr.me{justify-content:flex-end}
.ca{width:28px;height:28px;flex:none}
.ca img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block}
.bb{max-width:72%;padding:10px 15px;border-radius:20px;font-size:14px;line-height:1.4;background:#262a31;word-break:break-word}
.cr.me .bb{background:linear-gradient(180deg,#9a32d8,#5a49f0)}
.bb.ty{display:inline-flex;gap:4px;padding:15px 16px}
.bb.ty i{width:7px;height:7px;border-radius:50%;background:#8a919a;animation:bl 1s infinite}
.bb.ty i:nth-child(2){animation-delay:.15s}
.bb.ty i:nth-child(3){animation-delay:.3s}
@keyframes bl{0%,60%,100%{opacity:.35}30%{opacity:1}}
.cb{flex:none;margin:6px 10px 16px;background:#232830;border-radius:26px;padding:5px;display:flex;align-items:center;gap:8px}
.cb .cam{width:36px;height:36px;border-radius:50%;background:#4f5de8;display:grid;place-items:center;flex:none;cursor:pointer}
.cb input{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font-size:14px;font-family:inherit}
.cb .ri{display:flex;gap:12px;padding-right:8px}
.cb .ri i{display:block;cursor:pointer}
.cb .snd{display:none;background:none;border:0;color:#7c8cff;font-weight:700;font-size:14px;padding:0 10px;cursor:pointer;font-family:inherit}
.cb.has .ri{display:none}
.cb.has .snd{display:block}
.nt{display:flex;gap:10px;align-items:center;width:calc(100% - 32px);margin-top:30px;padding:12px;border-radius:22px;background:rgba(255,255,255,.18);backdrop-filter:blur(18px);text-align:left;cursor:pointer;box-shadow:0 4px 18px rgba(0,0,0,.25);animation:nin .5s .2s backwards}
.nt img{width:40px;height:40px;border-radius:50%;object-fit:cover;flex:none}
.nb{flex:1;min-width:0;font-size:13px;line-height:1.35}
.nh{display:flex;align-items:center;gap:6px}
.nh b{font-size:14px}
.nh span{opacity:.7;font-size:11px;flex:1}
.nh em{font-style:normal;opacity:.7;font-size:11px}
@keyframes nin{from{opacity:0;transform:translateY(-12px)}}
#app.dk{background:#000;color:#fff}
#app.dk .btn{background:#2a2a2e;color:#fff}
#app.dk .btn.go{background:#30b455}
